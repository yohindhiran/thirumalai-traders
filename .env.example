# Admin credentials (required)
ADMIN_EMAIL=admin@thirumalaaitraders.com
ADMIN_PASSWORD=change-this-strong-password

# Secret used to sign the admin session cookie (required, long random string)
AUTH_SECRET=generate-a-long-random-secret-here

# Public site URL used for SEO / sitemap
NEXT_PUBLIC_SITE_URL=https://www.thirumalaaitraders.com

# Supabase database configuration (get from your Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
DATABASE_URL=postgresql://postgres.your-project-id:your-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true
