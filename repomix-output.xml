          );
        })}
      </div>

      {/* Main image */}
      <div className="relative flex-1 overflow-hidden rounded-2xl border border-brand-line bg-brand-soft shadow-card">
        <div className="relative aspect-square w-full">
          <Image
            src={active}
            alt={name}
            fill
            priority
            sizes="(max-width: 1024px) 100vw, 40vw"
